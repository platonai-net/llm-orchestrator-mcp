    "windsurf",
    "kimi-code",
    "gpt",
    "claude",
    "gemini",
    "mistral",
    "llama"
  ],
  "main": "server.js",
  "bin": { "llm-orchestrator-mcp": "./server.js" },
  "scripts": {
    "start": "node server.js",
    "test": "node --test",
    "install": "bash install.sh"
  },
  "engines": { "node": ">=18" },
  "repository": {
